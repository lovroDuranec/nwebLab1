    "pg": "^8.23.1",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.22.1",
    "@types/qrcode": "^1.5.6",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  }

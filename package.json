    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-openid-connect": "^3.4.0",
    "pug": "^3.0.4",
    "pg": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.6",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "@types/pg": "^8.22.1"
  }
}